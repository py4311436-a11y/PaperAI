{
  "name": "paperai-poc",
  "private": true,
  "version": "0.7.4",
  "type": "module",
  "description": "PaperAI — Read · Annotate · Ask. Windows desktop PDF reader (Tauri 2 + PDF.js)",
  "scripts": {
    "sync:assets": "node scripts/sync-pdfjs-assets.mjs",
    "fixtures": "node scripts/make-test-pdfs.mjs && node scripts/make-fixtures.mjs",
    "verify:fixtures": "node scripts/verify-test-fixtures.mjs",
    "dev": "npm run sync:assets && vite",
    "build": "npm run sync:assets && node scripts/prune-dist.mjs mark && tsc --noEmit && vite build && node scripts/prune-dist.mjs sweep",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "icon": "node scripts/make-icon.mjs && tauri icon assets/icon-source.png",
    "build:automation": "node scripts/build.mjs --automation",
    "build:release": "node scripts/build.mjs --release",
    "test:ai-unit": "node scripts/run-ai-unit-tests.mjs",
    "test:ai-rust": "node scripts/run-ai-rust-tests.mjs",
    "test:ai": "npm run test:ai-unit && npm run test:ai-rust",
    "verify:bundle": "node scripts/verify-release-bundle.mjs",
    "test:ui-overlay": "node tests/overlay-visibility.mjs",
    "test:all": "npm run test:ai && npm run test:ui",
    "release:collect": "node scripts/collect-release.mjs",
    "size:report": "node scripts/size-report.mjs",
    "verify:no-profiles": "node scripts/verify-no-profile-data.mjs",
    "test:ui-picker": "node tests/provider-model-picker.mjs",
    "test:ui-panel": "node tests/panel-model-switch.mjs",
    "test:ui-toolbar": "node tests/toolbar-state.mjs",
    "test:ui": "npm run test:ui-overlay && npm run test:ui-picker && npm run test:ui-panel && npm run test:ui-toolbar"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.3",
    "@tauri-apps/plugin-dialog": "2.8.2",
    "katex": "0.16.25",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.2",
    "puppeteer-core": "^24.10.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
