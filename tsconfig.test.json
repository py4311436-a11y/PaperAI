{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": false,
    "skipLibCheck": true,
    "noEmit": false,
    "outDir": "dist-test",
    "rootDir": ".",
    "declaration": false,
    "sourceMap": false,
    "allowJs": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/ai/chat-controller.ts",
    "src/ai/chat-panel.ts",
    "src/ai/context-builder.ts",
    "src/ai/image-capture.ts",
    "src/ai/markdown-renderer.ts",
    "src/ai/memory.ts",
    "src/ai/screenshot-overlay.ts",
    "src/ai/types.ts",
    "src/ai/vision-support.ts",
    "src/tools/erase-policy.ts",
    "src/pdf/text-compose.ts",
    "src/pdf/wheel-zoom.ts",
    "src/ai/tool-calls.ts",
    "tests/ai-unit/run.ts"
  ]
}
